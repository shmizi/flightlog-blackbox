{
  "id": "vSwaMrtpsumbM67F",
  "name": "FlightLog Black Box",
  "nodes": [
    {
      "parameters": {
        "content": "## FlightLog Black Box\n\nDrop a `.bin` or `.tlog` into the watched folder. It is sent to the analysis API and the verdict is emailed to the team with the reports attached.\n\nSet up with `python scripts/setup_n8n.py` (fills in the folder, emails and the Gmail App Password, then switches this workflow on). Start everything with `scripts/start.ps1`.\n\nIf the API does not answer after 3 tries, the team gets an 'analysis service offline' email (E7).",
        "height": 300,
        "width": 420
      },
      "id": "5c1f0d3e-1a52-4f0e-9a51-6f1e2b7c9d01",
      "name": "Setup notes",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [-120, -380]
    },
    {
      "parameters": {
        "triggerOn": "folder",
        "path": "__WATCH_FOLDER__",
        "events": ["add"],
        "options": {
          "awaitWriteFinish": true,
          "usePolling": true,
          "ignored": "**/*.{tmp,crdownload,part}",
          "depth": 0
        }
      },
      "id": "8a0d4c2e-3b6f-4d1a-b7e2-1c9f5a3e7b02",
      "name": "Watch log folder",
      "type": "n8n-nodes-base.localFileTrigger",
      "typeVersion": 1,
      "position": [0, 0]
    },
    {
      "parameters": {
        "operation": "read",
        "fileSelector": "={{ $json.path.replaceAll('\\\\', '/') }}",
        "options": {
          "dataPropertyName": "data"
        }
      },
      "id": "2e7b9f41-6c3d-4a8e-9f10-4b2d8c6a1e03",
      "name": "Read log",
      "type": "n8n-nodes-base.readWriteFile",
      "typeVersion": 1.1,
      "position": [240, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "__API_URL__/analyze?inline=true",
        "sendBody": true,
        "contentType": "multipart-form-data",
        "bodyParameters": {
          "parameters": [
            {
              "parameterType": "formBinaryData",
              "name": "file",
              "inputDataFieldName": "data"
            }
          ]
        },
        "options": {
          "timeout": 120000,
          "batching": {
            "batch": {
              "batchSize": 1,
              "batchInterval": 0
            }
          }
        }
      },
      "id": "c4a81e5f-9d27-4b3c-8e6a-7f0b2d4c9a04",
      "name": "Analyze log",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [480, 0],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Turn the API's base64 attachments into binary fields the email node can attach.\nconst result = $json;\nconst binary = {};\nconst names = [];\n(result.attachments || []).forEach((a, i) => {\n  const key = `attachment_${i}`;\n  binary[key] = { data: a.data, mimeType: a.mimeType, fileName: a.fileName };\n  names.push(key);\n});\nconst { attachments, ...rest } = result;\nreturn { json: { ...rest, attachmentNames: names.join(',') }, binary };"
      },
      "id": "7f3e2a91-0b4c-4d6e-a8f2-9c1d5e7b3a05",
      "name": "Attach reports",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [720, -100]
    },
    {
      "parameters": {
        "fromEmail": "__FROM_EMAIL__",
        "toEmail": "__TO_EMAIL__",
        "subject": "={{ $json.email.subject }}",
        "emailFormat": "both",
        "text": "={{ $json.email.body }}",
        "html": "={{ $json.email.html }}",
        "options": {
          "appendAttribution": false,
          "attachments": "={{ $json.attachmentNames }}"
        }
      },
      "id": "e1b5c7d2-4a8f-4e3b-9d6c-2f7a1b5e8c06",
      "name": "Email debrief",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [960, -100],
      "credentials": {
        "smtp": {
          "id": "flightlogSmtp001",
          "name": "FlightLog email (SMTP)"
        }
      }
    },
    {
      "parameters": {
        "fromEmail": "__FROM_EMAIL__",
        "toEmail": "__TO_EMAIL__",
        "subject": "[FlightLog] Analysis service offline",
        "emailFormat": "text",
        "text": "=The analysis API could not process {{ $('Read log').item.binary.data.fileName }} after 3 tries, 5 s apart.\n\nError: {{ $json.error ? ($json.error.message || JSON.stringify($json.error)) : 'no response' }}\n\nStart everything with scripts/start.ps1, then drop the log into the folder again.",
        "options": {
          "appendAttribution": false
        }
      },
      "id": "9d2c6e4a-7b1f-4c8e-b3a5-0e6f2d9c1b07",
      "name": "Email: service offline",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [720, 120],
      "credentials": {
        "smtp": {
          "id": "flightlogSmtp001",
          "name": "FlightLog email (SMTP)"
        }
      }
    }
  ],
  "connections": {
    "Watch log folder": {
      "main": [[{"node": "Read log", "type": "main", "index": 0}]]
    },
    "Read log": {
      "main": [[{"node": "Analyze log", "type": "main", "index": 0}]]
    },
    "Analyze log": {
      "main": [
        [{"node": "Attach reports", "type": "main", "index": 0}],
        [{"node": "Email: service offline", "type": "main", "index": 0}]
      ]
    },
    "Attach reports": {
      "main": [[{"node": "Email debrief", "type": "main", "index": 0}]]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "pinData": {}
}
